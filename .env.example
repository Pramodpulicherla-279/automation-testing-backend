# Browser origins allowed to call this API, comma-separated. Add the deployed
# frontend's URL here (e.g. on Render), or its requests are blocked by CORS.
# "*" is not allowed because the API accepts credentials.
# CORS_ALLOW_ORIGINS=http://localhost:5173,https://your-frontend.onrender.com

# Database and integration secrets live in app/.env — see app/.env.example.
# On a cloud host with no app/.env, set MYSQL_* as service environment variables.

# The test runner needs no configuration here: it connects to this backend from
# the laptop at /runner/ws.
