# ── Test runner ─────────────────────────────────────────────────────────────
# Device, Appium, APK and run work is done by the runner (automation-testing/
# runner) on the machine with the Android device. Locally that is
# http://localhost:8100; from a cloud host, the tunnel URL that reaches it.
RUNNER_URL=http://localhost:8100
# Shared secret. Must equal the runner's RUNNER_TOKEN, or every call is refused.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
RUNNER_TOKEN=

# Browser origins allowed to call this API, comma-separated. Add the deployed
# frontend's URL here (e.g. on Render), or its requests are blocked by CORS.
# "*" is not allowed because the API accepts credentials.
# CORS_ALLOW_ORIGINS=http://localhost:5173,https://your-frontend.onrender.com

# Database and integration secrets live in app/.env — see app/.env.example.
# On a cloud host with no app/.env, set MYSQL_* as service environment variables.

# APK storage, Allure and the tests-repo location are configured where the
# runner runs — see automation-testing/.env.example.
