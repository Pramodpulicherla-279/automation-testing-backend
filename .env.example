# Where the tests repo is checked out. Only needed when it is not a sibling
# folder named automation-testing.
# TESTS_REPO_PATH=C:\Users\pramo\OneDrive\Desktop\Projects\automation-testing

# Allure CLI. Override if it is not installed at the scoop shim path.
# ALLURE_CMD=C:\Users\Pramo\scoop\shims\allure

# ── Runtime data ────────────────────────────────────────────────────────────
# APKs and extracted icons are stored outside the repo so they survive a
# redeploy or a fresh clone. Defaults to %PROGRAMDATA%\TestAutomationPlatform
# on Windows (machine-wide, shared across user accounts) and
# ~/.test-automation-platform elsewhere.
#
# In CI, point this at a workspace or cache path:
# PLATFORM_DATA_DIR=D:\ci\test-automation-data
#
# Override the individual folders only if they must live on separate volumes:
# APK_STORAGE_DIR=D:\apks
# APK_ICON_DIR=D:\apk-icons

# Database and integration secrets live in app/.env — see app/.env.example.
